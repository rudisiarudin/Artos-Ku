# ==============================================================================
# ARTOSKU — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Supabase Project Configuration (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Supabase Service Role Key for server-side administrative actions
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# App Environment
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_DEFAULT_CURRENCY=IDR
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Jakarta
